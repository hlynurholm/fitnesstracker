{
  // Cloudflare Worker config. See README.md for setup steps.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fitness-tracker",
  "main": "src/index.js",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fitness-tracker-db",
      // Replace with the id printed by: npx wrangler d1 create fitness-tracker-db
      // (scripts/setup-cloudflare.sh does this for you). Any value works for local dev.
      "database_id": "bf924543-83df-4f3e-be86-7caf75480b83",
      "migrations_dir": "migrations"
    }
  ],
  // Every 30 minutes: pull new Garmin activities (src/garmin.js). A no-op until the GARMIN_API_KEY secret is set.
  "triggers": { "crons": ["*/30 * * * *"] },
  "vars": {
    // Non-secret config. Secrets (APP_PASSWORD, API_TOKEN, GARMIN_API_KEY) are set with `wrangler secret put`.
    "APP_NAME": "Fitness tracker",
    "SESSION_DAYS": "180",
    // Garmin activity type to import automatically. Empty string imports every type.
    "GARMIN_ACTIVITY_TYPE": "running"
  }
}
